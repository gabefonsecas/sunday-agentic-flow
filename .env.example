# Friday MCP
FRIDAY_MCP_BASE_URL=https://friday.eletromidia.com.br/api/mcp_sse.php
FRIDAY_MCP_API_TOKEN=replace_with_your_friday_token
# Transport reliability. Defaults are suitable for normal use.
# FRIDAY_MCP_TIMEOUT=60
# FRIDAY_MCP_RETRIES=3
# FRIDAY_MCP_BACKOFF=0.5
# Required only when the board has multiple people columns.
# FRIDAY_ASSIGNEE_COLUMN=Responsible
# Optional fallback for accounts without any Friday task.
# FRIDAY_FALLBACK_ASSIGNEE_EMAIL=developer@example.com

# Optional cross-provider credentials. Configure only used providers.
# OPENAI_API_KEY=replace_with_your_openai_key
# ANTHROPIC_API_KEY=replace_with_your_anthropic_key
# GEMINI_API_KEY=replace_with_your_gemini_key

# Optional release source override.
# SUNDAY_RELEASE_REPOSITORY=gabefonsecas/sunday-agentic-flow
